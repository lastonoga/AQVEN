{
  "$defs": {
    "BootstrapSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "BCa",
          "title": "Method",
          "type": "string"
        },
        "resamples": {
          "minimum": 1,
          "title": "Resamples",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "resamples",
        "seed"
      ],
      "title": "BootstrapSpec",
      "type": "object"
    },
    "GateAction": {
      "enum": [
        "release",
        "require_approval",
        "reject"
      ],
      "title": "GateAction",
      "type": "string"
    },
    "GateActions": {
      "additionalProperties": false,
      "properties": {
        "block": {
          "$ref": "#/$defs/GateAction"
        },
        "gate_unavailable": {
          "$ref": "#/$defs/GateAction"
        },
        "pass": {
          "$ref": "#/$defs/GateAction"
        },
        "warn": {
          "$ref": "#/$defs/GateAction"
        }
      },
      "required": [
        "pass",
        "warn",
        "block",
        "gate_unavailable"
      ],
      "title": "GateActions",
      "type": "object"
    },
    "GateFamilies": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Primary",
          "type": "array"
        },
        "safety": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safety"
        },
        "secondary": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secondary"
        }
      },
      "required": [
        "primary"
      ],
      "title": "GateFamilies",
      "type": "object"
    },
    "GateSpec": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "$ref": "#/$defs/GateActions"
        },
        "alpha_primary": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alpha Primary",
          "type": "number"
        },
        "alpha_safety": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Alpha Safety",
          "type": "number"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "bootstrap": {
          "$ref": "#/$defs/BootstrapSpec"
        },
        "families": {
          "$ref": "#/$defs/GateFamilies"
        },
        "judge_admission": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeAdmission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_dropped_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Dropped Ratio",
          "type": "number"
        },
        "min_dataset": {
          "minimum": 1,
          "title": "Min Dataset",
          "type": "integer"
        },
        "min_discordant": {
          "minimum": 0,
          "title": "Min Discordant",
          "type": "integer"
        },
        "ni_margin": {
          "minimum": 0,
          "title": "Ni Margin",
          "type": "number"
        },
        "q_secondary": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Q Secondary",
          "type": "number"
        },
        "repeats": {
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        }
      },
      "required": [
        "baseline",
        "repeats",
        "min_dataset",
        "min_discordant",
        "families",
        "alpha_primary",
        "q_secondary",
        "alpha_safety",
        "ni_margin",
        "bootstrap",
        "max_dropped_ratio",
        "actions"
      ],
      "title": "GateSpec",
      "type": "object"
    },
    "JsonValue": {},
    "JudgeAdmission": {
      "additionalProperties": false,
      "properties": {
        "calibration_dataset": {
          "title": "Calibration Dataset",
          "type": "string"
        },
        "min_krippendorff_alpha": {
          "maximum": 1,
          "minimum": -1,
          "title": "Min Krippendorff Alpha",
          "type": "number"
        },
        "min_weighted_kappa": {
          "maximum": 1,
          "minimum": -1,
          "title": "Min Weighted Kappa",
          "type": "number"
        }
      },
      "required": [
        "min_weighted_kappa",
        "min_krippendorff_alpha",
        "calibration_dataset"
      ],
      "title": "JudgeAdmission",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests"
        },
        "seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "usd_micros": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usd Micros"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "MetricKind": {
      "enum": [
        "binary",
        "ordinal",
        "continuous"
      ],
      "title": "MetricKind",
      "type": "string"
    },
    "OptimizationSpec": {
      "additionalProperties": false,
      "properties": {
        "dev_split": {
          "title": "Dev Split",
          "type": "string"
        },
        "engine": {
          "const": "gepa",
          "title": "Engine",
          "type": "string"
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/Limits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_metric_calls": {
          "minimum": 1,
          "title": "Max Metric Calls",
          "type": "integer"
        },
        "max_repairs": {
          "maximum": 3,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "reflection_agent": {
          "title": "Reflection Agent",
          "type": "string"
        },
        "stop_score": {
          "title": "Stop Score",
          "type": "number"
        },
        "train_split": {
          "title": "Train Split",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "objective",
        "train_split",
        "dev_split",
        "reflection_agent",
        "max_metric_calls",
        "max_repairs",
        "stop_score"
      ],
      "title": "OptimizationSpec",
      "type": "object"
    },
    "ScorerSpec": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "inference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference"
        },
        "kind": {
          "$ref": "#/$defs/MetricKind"
        },
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "use": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use"
        },
        "with": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "With"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ScorerSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "apiVersion": {
      "const": "aqven/v1",
      "title": "Apiversion",
      "type": "string"
    },
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inference": {
      "title": "Inference",
      "type": "string"
    },
    "kind": {
      "const": "Eval",
      "title": "Kind",
      "type": "string"
    },
    "optimization": {
      "anyOf": [
        {
          "$ref": "#/$defs/OptimizationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scorers": {
      "items": {
        "$ref": "#/$defs/ScorerSpec"
      },
      "minItems": 1,
      "title": "Scorers",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "description",
    "inference",
    "agent",
    "dataset",
    "scorers"
  ],
  "title": "EvalSpec",
  "type": "object"
}
