            "$ref": "#/$defs/JsonValue"
          },
          "title": "Out",
          "type": "object"
        }
      },
      "required": [
        "name",
        "in",
        "out"
      ],
      "title": "ExampleSpec",
      "type": "object"
    },
    "FieldDecl": {
      "additionalProperties": false,
