{
  "name": "@aqven/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "node scripts/generate_llms.mjs && astro dev",
    "build": "corepack pnpm reference:check && node scripts/generate_llms.mjs && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "reference": "uv run --project ../.. python ../../tools/generate_reference.py",
    "reference:check": "uv run --project ../.. python ../../tools/generate_reference.py --check",
    "llms": "node scripts/generate_llms.mjs",
    "llms:check": "node scripts/generate_llms.mjs --check",
    "landing:check": "corepack pnpm build && node scripts/check-landing-page.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "6.0.6",
    "@astrojs/starlight": "0.42.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.3.3",
    "astro-mermaid": "2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.46.0",
    "lucode-starlight": "1.0.0",
    "mermaid": "11.17.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.5.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.4.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "typescript": "6.0.3"
  }
}
