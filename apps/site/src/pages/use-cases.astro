---
import "../styles/landing.css";
import SeoHead from "@/components/landing/SeoHead.astro";
import { Navbar1 } from "@/components/navbar1";
import { latestRelease } from "@/lib/latest-release";
import { Hero1 } from "@/components/hero1";
import { Cta10 } from "@/components/cta10";
import { Footer2 } from "@/components/footer2";
import {
  SituationSections,
  WhoDoesWhat,
  useCasesIndexVisual,
} from "@/components/landing/use-cases";
import {
  AUTH,
  FOOTER_COPYRIGHT,
  FOOTER_DESCRIPTION,
  FOOTER_LEGAL,
  FOOTER_LOGO,
  FOOTER_SECTIONS,
  LOGO,
  MENU,
  QUICKSTART,
  REPO,
} from "@/components/landing/site-nav";
import { SITUATIONS, USE_CASES_PATH, situationHref } from "@/components/landing/situations";

const TITLE = "What AQVEN is for: find, explain, compare, confirm, build";
const DESCRIPTION =
  "Find, explain, compare, confirm, build: five situations from building multi-step AI workflows, and what you and your coding agent do about each in AQVEN.";

const release = await latestRelease;

const siteUrl = new URL("/", Astro.site).href;
const pageUrl = new URL(USE_CASES_PATH, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: TITLE,
  description: DESCRIPTION,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", "@id": `${siteUrl}#website`, name: "AQVEN", url: siteUrl },
  mainEntity: {
    "@type": "ItemList",
    name: "What AQVEN is for",
    numberOfItems: SITUATIONS.length,
    itemListElement: SITUATIONS.map((situation, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: situation.title,
      url: new URL(situationHref(situation.id), siteUrl).href,
    })),
  },
};
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <SeoHead title={TITLE} description={DESCRIPTION} path={USE_CASES_PATH} jsonLd={jsonLd} />
  </head>
  <body>
    <Navbar1 client:load logo={LOGO} menu={MENU} auth={AUTH} release={release} />

    <main>
      <Hero1
        badge={{ text: "Use cases" }}
        heading="What AQVEN is for."
        description="Five situations from building multi-step AI workflows, and what you and your coding agent do about each in AQVEN."
        buttons={{
          primary: { text: "Get started", url: QUICKSTART },
          secondary: { text: "GitHub", url: REPO },
        }}
        visual={useCasesIndexVisual}
      />

      <WhoDoesWhat />
      <SituationSections />

      <Cta10
        heading="Start with one question."
        description="Run a small experiment. Inspect the evidence. Decide what comes next."
        buttons={{
          primary: { text: "Get started", url: QUICKSTART },
          secondary: { text: "GitHub", url: REPO },
        }}
      />
    </main>

    <Footer2
      logo={FOOTER_LOGO}
      description={FOOTER_DESCRIPTION}
      sections={FOOTER_SECTIONS}
      copyright={FOOTER_COPYRIGHT}
      legalLinks={FOOTER_LEGAL}
    />
  </body>
</html>
