---
import "../styles/landing.css";
import { Navbar1 } from "@/components/navbar1";
import { Hero1 } from "@/components/hero1";
import { Feature15 } from "@/components/feature15";
import { Cta10 } from "@/components/cta10";
import { Footer2 } from "@/components/footer2";
import {
  AGENT_FEATURES,
  Comparison,
  Problem,
  Stack,
  StudioEvidence,
  WhatsInside,
  TrustStrip,
} from "@/components/landing/sections";

const repo = "https://github.com/lastonoga/AQVEN";
const docs = "/start/";
const quickstart = "/start/quickstart/";

const logo = {
  url: "/",
  src: "/favicon.svg",
  alt: "AQVEN",
  title: "AQVEN",
};

const menu = [
  { title: "Documentation", url: docs },
  { title: "Engine", url: "/engine/" },
  { title: "Studio", url: "/studio/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AQVEN — The source-available workbench for AI workflows</title>
    <meta
      name="description"
      content="Built for humans and coding agents. Build your AI workflow, check it before it runs, and see exactly what it did."
    />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      if (
        localStorage.getItem("starlight-theme") === "dark" ||
        (!localStorage.getItem("starlight-theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <Navbar1
      client:load
      logo={logo}
      menu={menu}
      auth={{
        login: { title: "GitHub", url: repo },
        signup: { title: "Get started", url: quickstart },
      }}
    />

    <main>
      <Hero1
        badge={{ text: "Source available · Runs on your machine" }}
        heading="Build AI workflows you can trust to run the business."
        description="AQVEN helps engineers build, inspect, test, and improve AI agents, automations, and business processes — before unreliable behavior reaches customers."
        command="uv tool install aqven"
        buttons={{
          primary: { text: "Get started", url: quickstart },
          secondary: { text: "GitHub", url: repo },
        }}
        image={{
          src: "/images/studio/canvas.png",
          alt: "AQVEN Studio showing a multi-step AI workflow on one canvas",
        }}
      />

      <TrustStrip />
      <Problem />
      <StudioEvidence client:visible />
      <WhatsInside />

      <Feature15
        label="For coding agents"
        heading="Your coding agent stops guessing."
        description="Claude Code and Cursor are already writing your AI workflows. Give them something to read."
        features={AGENT_FEATURES}
      />

      <Comparison />
      <Stack />

      <Cta10
        heading="Start with a workflow you already have."
        description="Point AQVEN at your project. Nothing to rewrite, no account, runs on your machine."
        buttons={{
          primary: { text: "Get started", url: quickstart },
          secondary: { text: "GitHub", url: repo },
        }}
      />
    </main>

    <Footer2
      logo={{ url: "/", src: "/favicon.svg", alt: "AQVEN", title: "AQVEN" }}
      description="The source-available workbench for AI workflows."
      sections={[
        {
          title: "Documentation",
          links: [
            { name: "Overview", href: docs },
            { name: "Engine", href: "/engine/" },
            { name: "Studio", href: "/studio/" },
            { name: "Concepts", href: "/concepts/" },
          ],
        },
        {
          title: "Build",
          links: [
            { name: "Workflows", href: "/concepts/files-as-source-of-truth/" },
            { name: "Nodes", href: "/concepts/ten-kinds-of-nodes/" },
            { name: "Prompts", href: "/engine/prompts/" },
            { name: "Tools", href: "/engine/tool-node/" },
          ],
        },
        {
          title: "Improve",
          links: [
            { name: "Runs", href: "/studio/investigate-a-run/" },
            { name: "Datasets", href: "/studio/datasets/" },
            { name: "Evaluations", href: "/studio/evals/" },
            { name: "Debugging", href: "/concepts/finding-the-node-that-went-wrong/" },
          ],
        },
      ]}
      copyright="AQVEN. Source available."
      legalLinks={[{ name: "GitHub", href: repo }]}
    />
  </body>
</html>
