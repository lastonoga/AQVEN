---
import "../styles/landing.css";
import { Navbar1 } from "@/components/navbar1";
import { latestRelease } from "@/lib/latest-release";
import { Hero1 } from "@/components/hero1";
import { Cta10 } from "@/components/cta10";
import { Footer2 } from "@/components/footer2";
import {
  Comparison,
  FAQ,
  ResearchLoop,
  Situations,
  Stack,
  StudioEvidence,
  TrustStrip,
} from "@/components/landing/sections";
import { Providers } from "@/components/landing/provider-logos";
import { heroCanvasVisual } from "@/components/landing/schematics";
import {
  AUTH,
  FOOTER_COPYRIGHT,
  FOOTER_DESCRIPTION,
  FOOTER_LEGAL,
  FOOTER_LOGO,
  FOOTER_SECTIONS,
  LOGO,
  MENU,
  QUICKSTART,
  REPO,
} from "@/components/landing/site-nav";

const startButtons = {
  primary: { text: "Get started", url: QUICKSTART },
  secondary: { text: "GitHub", url: REPO },
};

const release = await latestRelease;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AQVEN: Discover what your AI workflow needs to work reliably</title>
    <meta
      name="description"
      content="A Python framework and a local Studio for multi-step AI workflows. Your coding agent builds, runs and experiments on the workflow. You inspect the evidence and decide what to change."
    />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      if (
        localStorage.getItem("starlight-theme") === "dark" ||
        (!localStorage.getItem("starlight-theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <Navbar1 client:load logo={LOGO} menu={MENU} auth={AUTH} release={release} />

    <main>
      <Hero1
        badge={{ text: "For engineers building multi-step AI workflows" }}
        heading="Discover what your AI workflow needs to work reliably."
        description="AQVEN is a Python framework and a local Studio for AI workflows. Your coding agent runs the experiments, and you see the evidence."
        command="uv tool install aqven"
        buttons={startButtons}
        visual={heroCanvasVisual}
      />

      <TrustStrip />
      <Situations />
      <ResearchLoop />
      <StudioEvidence />
      <Comparison />
      <Stack />
      <Providers />
      <FAQ client:visible />

      <Cta10
        heading="Start with one question."
        description="Run a small experiment. Inspect the evidence. Decide what comes next."
        buttons={startButtons}
      />
    </main>

    <Footer2
      logo={FOOTER_LOGO}
      description={FOOTER_DESCRIPTION}
      sections={FOOTER_SECTIONS}
      copyright={FOOTER_COPYRIGHT}
      legalLinks={FOOTER_LEGAL}
    />
  </body>
</html>
