---
import LucodeSidebarSublist from './LucodeSidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

const AREA_BY_PREFIX = [
  { prefix: '/start/', label: 'Start', id: 'start' },
  { prefix: '/engine/', label: 'Engine', id: 'engine' },
  { prefix: '/studio/', label: 'Studio', id: 'studio' },
  { prefix: '/mcp-cli/', label: 'MCP & CLI', id: 'mcp-cli' },
  { prefix: '/integrations/', label: 'Integrations', id: 'integrations' },
  { prefix: '/reference/', label: 'Reference', id: 'reference' },
  { prefix: '/concepts/', label: 'Concepts', id: 'concepts' },
] as const;
const currentArea =
  AREA_BY_PREFIX.find((area) => Astro.url.pathname.startsWith(area.prefix)) ?? AREA_BY_PREFIX[0];
const isHome = currentArea.id === 'start';
const manual = sidebar.flatMap((entry) =>
  entry.type === 'group' && entry.label === currentArea.label ? entry.entries : [],
);
const manualId = currentArea.id;
---

<div class="sidebar">
  <div class="sidebar-border-gradient"></div>
  <div class="sidebar-spacer"></div>
  <div class="sidebar-fade-top"></div>
  <div class="container-sidebar" data-aqven-sidebar={manualId}>
    <div class="sidebar-entries">
      {isHome ? (
        <section class="home-sidebar-section" data-home-sidebar-section>
          <h2 class="home-sidebar-title">Start</h2>
          <LucodeSidebarSublist sublist={manual} />
        </section>
      ) : (
        <LucodeSidebarSublist sublist={manual} />
      )}
    </div>
    <div class="sidebar-fade-bottom"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const sidebar = document.querySelector('[data-aqven-sidebar]');
    if (!(sidebar instanceof HTMLElement)) return;

    const storageKey = `aqven-docs-sidebar-scroll:${sidebar.dataset.aqvenSidebar}`;
    try {
      const restore = Number(sessionStorage.getItem(storageKey));
      if (Number.isFinite(restore) && restore > 0) {
        requestAnimationFrame(() => requestAnimationFrame(() => { sidebar.scrollTop = restore; }));
      }

      const persist = () => sessionStorage.setItem(storageKey, String(sidebar.scrollTop));
      sidebar.addEventListener('scroll', persist, { passive: true });
      addEventListener('pagehide', persist);
      addEventListener('visibilitychange', () => document.visibilityState === 'hidden' && persist());
    } catch {}
  })();
</script>

<style>
  .sidebar { position: relative; display: flex; height: 100%; overflow: hidden; flex-direction: column; scrollbar-width: none; }
  .sidebar-spacer { flex-shrink: 0; height: 2.25rem; }
  .sidebar-border-gradient { position: absolute; z-index: 1; top: 0; right: 0.5rem; bottom: 0; display: none; width: 1px; background: linear-gradient(to bottom, transparent 0%, var(--border) 50%, transparent 100%); }
  .sidebar-fade-top { position: absolute; z-index: 10; top: 2rem; left: 0; width: calc(100% - 1rem); height: 2rem; pointer-events: none; background-image: linear-gradient(to bottom, var(--background) 0%, color-mix(in srgb, var(--background) 80%, transparent) 50%, color-mix(in srgb, var(--background) 50%, transparent) 100%); filter: blur(2px); }
  .sidebar-fade-bottom { position: sticky; z-index: 10; bottom: -2px; flex-shrink: 0; height: 4rem; margin-top: calc(var(--spacing) * -16); pointer-events: none; background-image: linear-gradient(to top, var(--background) 0%, color-mix(in srgb, var(--background) 80%, transparent) 50%, color-mix(in srgb, var(--background) 50%, transparent) 100%); filter: blur(2px); }
  .container-sidebar { display: flex; flex: 1; flex-direction: column; min-height: 0; margin: 0 2rem; padding: calc(var(--spacing) * 6) calc(var(--spacing) * 6) 0 calc(var(--spacing) * 2); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
  .sidebar-entries { display: flex; flex-direction: column; gap: calc(var(--spacing) * 6); padding-bottom: calc(var(--spacing) * 16); }
  .home-sidebar-section { display: flex; flex-direction: column; gap: 0.5rem; }
  .home-sidebar-title { margin: 0; padding: 0.3rem 0.5rem; color: var(--muted-foreground); font-size: 0.75rem; font-weight: 600; line-height: 1.2rem; }
  @media (min-width: 1024px) { .sidebar-border-gradient { display: block; } .container-sidebar { max-height: calc(100svh - 10rem - 2.25rem); } }
</style>
