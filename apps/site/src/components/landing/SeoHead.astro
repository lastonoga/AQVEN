---
type JsonLd = Readonly<Record<string, unknown>>;

interface Props {
  readonly title: string;
  readonly description: string;
  readonly path: string;
  readonly jsonLd?: JsonLd;
}

const SITE_NAME = "AQVEN";

const SOCIAL_IMAGE = {
  path: "/og.png",
  width: 1200,
  height: 630,
  alt: "AQVEN Studio showing the graph of a multi-step AI workflow",
} as const;

const THEME_COLORS = [
  { scheme: "light", color: "#fafafa" },
  { scheme: "dark", color: "#171717" },
] as const;

const serializeJsonLd = (data: JsonLd): string => JSON.stringify(data).replaceAll("<", "\\u003c");

const { title, description, path, jsonLd } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const socialImage = new URL(SOCIAL_IMAGE.path, Astro.site).href;
const structuredData = jsonLd === undefined ? null : serializeJsonLd(jsonLd);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/logo.png" />
{
  THEME_COLORS.map(({ scheme, color }) => (
    <meta name="theme-color" media={`(prefers-color-scheme: ${scheme})`} content={color} />
  ))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
<meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
<meta property="og:image:alt" content={SOCIAL_IMAGE.alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={SOCIAL_IMAGE.alt} />

{structuredData !== null && <script type="application/ld+json" set:html={structuredData} />}

<script is:inline>
  if (
    localStorage.getItem("starlight-theme") === "dark" ||
    (!localStorage.getItem("starlight-theme") &&
      window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    document.documentElement.classList.add("dark");
  }
</script>
