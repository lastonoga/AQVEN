apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "Parses the case text and every attachment: summary, category, observations, safety risk, marketplace fields"
agent: "gemini"
in:
- name: "message"
  from: "$prepare.out.message"
- name: "channel"
  from: "$prepare.out.channel"
- name: "customer"
  from: "$input.customer"
- name: "product"
  from: "$input.product"
- name: "signals"
  from: "$prepare.out.signals"
- name: "intake_fields"
  from: "$prepare.out.intake_fields"
- name: "photo"
  from: "$input.photo"
- name: "voice_note"
  from: "$input.voice_note"
- name: "video"
  from: "$input.video"
- name: "invoice"
  from: "$input.invoice"
