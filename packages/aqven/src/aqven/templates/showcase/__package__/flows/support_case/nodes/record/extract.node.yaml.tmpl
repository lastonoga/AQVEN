apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "Fills the form from the text, the photo and the invoice; on a repeat it takes the review remarks into account"
agent: "gemini"
in:
- name: "message"
  from: "$prepare.out.message"
- name: "summary"
  from: "$triage.out.summary"
- name: "form_fields"
  from: "$case_form.out.fields"
- name: "feedback"
  from: "$acc.validate.out.issues"
- name: "photo"
  from: "$input.photo"
- name: "invoice"
  from: "$input.invoice"
