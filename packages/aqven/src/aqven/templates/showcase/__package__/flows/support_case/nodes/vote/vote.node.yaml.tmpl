apiVersion: "aqven/v1"
kind: "Node"
node: "map"
description: "Three independent intent ballots from a cheap open model, one per perspective"
over: "$prepare.out.perspectives"
body: "ballot"
concurrency: 3
on_item_error:
  use: "skip"
out:
- name: "ballots"
  type: "IntentBallot[]"
  description: "Ballots that finished successfully"
  maxItems: 3
  from: "$ok"
