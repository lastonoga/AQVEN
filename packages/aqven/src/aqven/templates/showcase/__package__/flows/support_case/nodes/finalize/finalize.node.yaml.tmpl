apiVersion: "aqven/v1"
kind: "Node"
node: "code"
description: "Closes the case: its number, the status from the approvals, the final reply, the chosen media and the closing time"
run: "finalize"
in:
- name: "intent"
  type: "CaseIntent"
  description: "Final case intent"
  from: "$intent.out.intent"
- name: "tier"
  type: "CascadeTier"
  description: "The cascade stage that produced the intent"
  from: "$intent.out.tier"
- name: "record"
  type: "CaseRecord"
  description: "Case form"
  from: "$to_record.out"
- name: "resolution"
  type: "Resolution"
  description: "Decision on the case"
  from: "$route.out.resolution"
- name: "reply"
  type: "ReplyDraft"
  description: "The reply after polishing"
  from: "$polish.out.reply"
- name: "lead"
  type: "ReplyApproval"
  description: "The support lead's decision on the reply"
  from: "$approvals.out.lead"
- name: "media"
  type: "MediaApproval"
  description: "The brand editor's decision on the media"
  from: "$approvals.out.media"
- name: "image"
  type: "Image"
  description: "Instruction image"
  from: "$illustrate.out.image"
- name: "voice"
  type: "Audio"
  description: "Voice version of the reply"
  from: "$voice.out.voice"
- name: "clip"
  type: "Video"
  description: "Short clip built from the image"
  from: "$clip.out.clip"
out:
- name: "case_ref"
  type: "Text"
  description: "Case number"
  maxLength: 31
  pattern: "^CASE-[0-9A-HJKMNP-TV-Z]{26}$"
- name: "status"
  type: "CaseStatus"
  description: "Whether the reply was sent to the customer"
- name: "intent"
  type: "CaseIntent"
  description: "Final case intent"
- name: "tier"
  type: "CascadeTier"
  description: "The cascade stage that produced the intent"
- name: "record"
  type: "CaseRecord"
  description: "Case form"
- name: "resolution"
  type: "Resolution"
  description: "Decision on the case"
- name: "reply"
  type: "ReplyDraft?"
  description: "The reply that was sent; null when the reply was rejected"
- name: "media"
  type: "ReplyMedia"
  description: "Media approved to go out with the reply"
- name: "closed_at"
  type: "DateTime"
  description: "When the case was closed"
