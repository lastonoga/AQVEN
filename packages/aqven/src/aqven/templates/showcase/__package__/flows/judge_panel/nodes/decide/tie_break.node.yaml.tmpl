apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "Судья семейства OpenAI разрешает расхождение панели по её вердиктам"
agent: "gpt"
in:
- name: "summary"
  from: "$input.summary"
- name: "candidates"
  from: "$input.candidates"
- name: "chunks"
  from: "$input.chunks"
- name: "panel"
  from: "$judges.out.verdicts"
