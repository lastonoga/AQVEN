apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "An agent decides the warranty case: order, case history, policy through a subagent, store credit with approval"
agent: "resolver"
in:
- name: "customer"
  from: "$input.customer"
- name: "order_id"
  from: "$case.order_id"
- name: "symptom"
  from: "$case.symptom"
- name: "purchased_on"
  from: "$case.purchased_on"
- name: "safety_risk"
  from: "$case.safety_risk"
- name: "intake_extra"
  from: "$triage.out.intake_extra"
- name: "policies"
  from: "$search_kb.out.policies"
