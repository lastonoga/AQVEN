apiVersion: "aqven/v1"
kind: "Inference"
description: "Картинка-инструкция к ответу покупателю в стиле категории товара; фото покупателя, если оно есть, уходит модели вложением"
in:
- name: "text"
  type: "Text"
  description: "Текст ответа покупателю, шаги которого показывает картинка"
  maxLength: 1500
- name: "category"
  type: "ProductCategory"
  description: "Категория товара, задающая сцену картинки"
- name: "photo"
  type: "Image?"
  description: "Фото товара от покупателя; null, если фото не приложено"
out:
- name: "image"
  type: "Image"
  description: "Картинка-инструкция"
display:
  input:
    template: "illustrate.input.display.liquid"
  output:
    template: "illustrate.output.display.liquid"
prompt: "illustrate_prompt"
