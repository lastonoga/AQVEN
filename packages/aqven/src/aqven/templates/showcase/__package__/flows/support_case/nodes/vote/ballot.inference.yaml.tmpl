apiVersion: "aqven/v1"
kind: "Inference"
description: "The case intent from the summary and the observations; the perspective sets the angle of the ballot"
in:
- name: "summary"
  type: "Text"
  description: "Case summary after parsing"
  maxLength: 600
- name: "observations"
  type: "Observation[]"
  description: "Observations against the category signals"
  maxItems: 12
- name: "safety_risk"
  type: "Bool"
  description: "Whether the case shows signs of a safety hazard"
- name: "perspective"
  type: "VotePerspective?"
  description: "The angle of the ballot; null means a decision with no perspective set"
out:
- name: "rationale"
  type: "Text"
  description: "Reasoning for the intent, written before the choice"
  maxLength: 300
- name: "intent"
  type: "CaseIntent"
  description: "Case intent"
- name: "confidence"
  type: "Score"
  description: "Confidence in the chosen intent"
examples:
- name: "flicker_defect"
  in:
    summary: "An LED strip flickers in the section near the controller a week after install; it was wired as the manual says"
    observations:
    - key: "flicker"
      value: "Flicker near the controller, stronger at low brightness"
    safety_risk: false
    perspective: null
  out:
    rationale: "The product arrived working and stopped working properly under ordinary use, so this is a product defect"
    intent: "defect"
    confidence: 0.9
- name: "crushed_box"
  in:
    summary: "A table lamp arrived in a crushed box with a cracked shade; the customer asks to sort out the delivery"
    observations:
    - key: "package_damaged"
      value: "The box is crushed on one corner"
    - key: "cracked_shade"
      value: "A crack across the whole shade"
    safety_risk: false
    perspective: null
  out:
    rationale: "The packaging and the shade were damaged in transit, not in use, so this is a delivery problem"
    intent: "delivery"
    confidence: 0.85
