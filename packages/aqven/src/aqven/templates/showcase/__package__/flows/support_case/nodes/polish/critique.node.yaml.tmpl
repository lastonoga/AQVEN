apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "A critic from another family scores how well the reply is grounded in the knowledge base and how complete it is"
agent: "mistral"
in:
- name: "summary"
  from: "$triage.out.summary"
- name: "resolution"
  from: "$route.out.resolution"
- name: "chunks"
  from: "$search_kb.out.chunks"
- name: "reply"
  from: "$revise.out.reply"
