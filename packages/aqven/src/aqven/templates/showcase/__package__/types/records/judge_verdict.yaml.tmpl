apiVersion: "aqven/v1"
kind: "Type"
type: "record"
description: "Вердикт судьи по кандидатам ответа"
fields:
- name: "rationale"
  type: "Text"
  description: "Обоснование, написанное до баллов"
  maxLength: 600
- name: "scores"
  type: "CriterionScore[]"
  description: "Баллы лучшего кандидата по критериям"
  maxItems: 3
- name: "best_index"
  type: "Int"
  description: "Номер лучшего кандидата, с нуля"
  minimum: 0
  maximum: 2
