apiVersion: "aqven/v1"
kind: "Type"
type: "record"
description: "Decision on the case"
fields:
- name: "action"
  type: "ResolutionAction"
  description: "What we do about the case"
- name: "summary"
  type: "Text"
  description: "The decision in short, for the customer and the agent"
  maxLength: 400
- name: "credit"
  type: "Money?"
  description: "Store credit amount; null when no credit is issued"
- name: "policy"
  type: "PolicyId?"
  description: "The policy the decision rests on; null when it does not rest on one"
