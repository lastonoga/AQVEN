apiVersion: "aqven/v1"
kind: "Type"
type: "record"
description: "Outcome of handling the customer case"
fields:
- name: "case_ref"
  type: "Text"
  description: "Case number"
  maxLength: 31
  pattern: "^CASE-[0-9A-HJKMNP-TV-Z]{26}$"
- name: "status"
  type: "CaseStatus"
  description: "Outcome of the case"
- name: "intent"
  type: "CaseIntent"
  description: "Case intent"
- name: "tier"
  type: "CascadeTier"
  description: "The cascade stage that settled the intent"
- name: "record"
  type: "CaseRecord"
  description: "Case form"
- name: "resolution"
  type: "Resolution"
  description: "Decision on the case"
- name: "reply"
  type: "ReplyDraft?"
  description: "The reply that was sent; null when the reply was rejected"
- name: "media"
  type: "ReplyMedia"
  description: "Media attached to the reply"
- name: "closed_at"
  type: "DateTime"
  description: "When the case was closed"
