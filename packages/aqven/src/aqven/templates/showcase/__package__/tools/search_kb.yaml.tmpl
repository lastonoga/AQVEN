apiVersion: "aqven/v1"
kind: "Tool"
description: "Search for knowledge base chunks and service policies by what the case is about"
run: "@root.tools.functions:search_kb"
effect: "read"
secrets:
- name: "kb_token"
  ref: "ref:env/LUMEN_KB_TOKEN"
in:
- name: "query"
  type: "Text"
  description: "Search query: what the case is about, in short"
  maxLength: 600
- name: "category"
  type: "ProductCategory"
  description: "Product category used to select articles"
- name: "locale"
  type: "Locale"
  description: "Language of the articles"
- name: "tenant"
  type: "TenantId"
  description: "The tenant whose knowledge base is used"
out:
- name: "chunks"
  type: "KbChunk[]"
  description: "Article chunks that were found"
  maxItems: 80
- name: "policies"
  type: "Policy[]"
  description: "Service policies that apply"
  maxItems: 20
