apiVersion: "aqven/v1"
kind: "Tool"
description: "A Lumen order by its number: purchase and delivery dates, total and line items"
run: "@root.tools.functions:lookup_order"
effect: "read"
secrets:
- name: "orders_token"
  ref: "ref:env/LUMEN_ORDERS_TOKEN"
in:
- name: "order_id"
  type: "OrderId"
  description: "Order number"
out:
- name: "order_id"
  type: "OrderId"
  description: "Order number"
- name: "placed_on"
  type: "Date"
  description: "Date the order was placed"
- name: "delivered_on"
  type: "Date?"
  description: "Delivery date; null when the order has not arrived yet"
- name: "total"
  type: "Money"
  description: "Order total"
- name: "items"
  type: "ProductRef[]"
  description: "Line items of the order"
  maxItems: 20
