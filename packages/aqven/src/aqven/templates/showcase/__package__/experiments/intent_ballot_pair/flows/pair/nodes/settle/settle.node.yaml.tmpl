apiVersion: "aqven/v1"
kind: "Node"
node: "code"
description: "Keeps the more confident of the two ballots; when they agree, that is their shared intent"
run: "settle"
in:
- name: "words"
  type: "IntentBallot"
  description: "The ballot on the customer's words"
  from: "$words.out"
- name: "evidence"
  type: "IntentBallot"
  description: "The ballot on the evidence"
  from: "$evidence.out"
out:
- name: "rationale"
  type: "Text"
  description: "Reasoning of the kept ballot"
  maxLength: 300
- name: "intent"
  type: "CaseIntent"
  description: "Intent of the kept ballot"
- name: "confidence"
  type: "Score"
  description: "Confidence of the kept ballot"
