apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "A single DeepSeek-family judge scores the drafts blind, as one panel judge does"
inference: "tie_break"
agent: "deepseek"
in:
- name: "summary"
  from: "$input.summary"
- name: "candidates"
  from: "$input.candidates"
- name: "chunks"
  from: "$input.chunks"
