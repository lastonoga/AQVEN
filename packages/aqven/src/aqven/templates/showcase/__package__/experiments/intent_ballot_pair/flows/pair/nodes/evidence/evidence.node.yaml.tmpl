apiVersion: "aqven/v1"
kind: "Node"
node: "llm"
description: "An intent ballot that reads first what the observations confirm, not what the customer says"
inference: "ballot"
agent: "llama"
in:
- name: "summary"
  from: "$triage.out.summary"
- name: "observations"
  from: "$triage.out.observations"
- name: "safety_risk"
  from: "$triage.out.safety_risk"
- name: "perspective"
  value: "evidence"
