apiVersion: "aqven/v1"
kind: "Experiment"
description: "A second intent ballot on the evidence, settled by confidence, gets the intent of a long message right more often than one ballot, with at most 5 points fewer outputs valid on the first try"
failure_mode: "intent_misread"
subject:
  flow: "intent_decision"
varies:
  what: "flow"
  nodes:
  - "ballots"
cases:
  dataset: "long_customer_messages"
variants:
- id: "single"
- id: "pair"
  nodes:
    ballots: "pair"
checks:
- id: "intent"
  kind: "binary"
  use: "expected"
  with:
    fields:
    - "intent"
question:
  kind: "compare"
  baseline: "single"
  candidate: "pair"
  primary: "intent"
  direction: "higher_is_better"
  margin: 0.05
  guardrails:
  - metric: "schema_valid_first_try"
    margin: 0.05
plan:
  cases: 12
  repeats: 3
