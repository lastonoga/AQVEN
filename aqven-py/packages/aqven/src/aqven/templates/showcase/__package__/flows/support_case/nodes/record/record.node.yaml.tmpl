apiVersion: "aqven/v1"
kind: "Node"
node: "loop"
description: "Заполняет анкету обращения по форме, проверяет бизнес-правилами и чинит по замечаниям"
body:
- "extract"
- "validate"
max_iter: 3
stop:
- run: "no_issues"
  with:
    path: "$iter.validate.out.issues"
select:
  use: "last"
out:
- name: "record"
  type: "Dynamic"
  description: "Анкета последней итерации"
  from: "$iter.extract.out.record"
  value_type: "CaseRecord"
