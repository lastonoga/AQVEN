apiVersion: "aqven/v1"
kind: "Tool"
description: "Поиск фрагментов базы знаний и политик обслуживания по сути обращения"
run: "@root.tools.functions:search_kb"
effect: "read"
secrets:
- name: "kb_token"
  ref: "ref:env/LUMEN_KB_TOKEN"
in:
- name: "query"
  type: "Text"
  description: "Поисковый запрос: краткая суть обращения"
  maxLength: 600
- name: "category"
  type: "ProductCategory"
  description: "Категория товара для отбора статей"
- name: "locale"
  type: "Locale"
  description: "Язык статей"
- name: "tenant"
  type: "TenantId"
  description: "Тенант, чья база знаний используется"
out:
- name: "chunks"
  type: "KbChunk[]"
  description: "Найденные фрагменты статей"
  maxItems: 80
- name: "policies"
  type: "Policy[]"
  description: "Применимые политики обслуживания"
  maxItems: 20
