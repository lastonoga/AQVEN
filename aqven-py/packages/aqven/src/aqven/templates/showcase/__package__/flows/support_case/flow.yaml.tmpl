apiVersion: "aqven/v1"
kind: "Flow"
description: "Обращение покупателя Lumen: разбор вложений, намерение голосованием с каскадом, анкета с ремонтом, решение, ответ по базе знаний с панелью судей и полировкой, медиа ответа и согласование людьми"
input: "CaseRequest"
output: "CaseOutcome"
returns:
- name: "case_ref"
  from: "$finalize.out.case_ref"
- name: "status"
  from: "$finalize.out.status"
- name: "intent"
  from: "$finalize.out.intent"
- name: "tier"
  from: "$finalize.out.tier"
- name: "record"
  from: "$finalize.out.record"
- name: "resolution"
  from: "$finalize.out.resolution"
- name: "reply"
  from: "$finalize.out.reply"
- name: "media"
  from: "$finalize.out.media"
- name: "closed_at"
  from: "$finalize.out.closed_at"
context:
- "date"
- "tenant_id"
order:
- "prepare"
- "triage"
- "vote"
- "tally"
- "intent"
- "case_form"
- "record"
- "to_record"
- "search_kb"
- "route"
- "drafts"
- "panel"
- "polish"
- "illustrate"
- "voice"
- "clip"
- "approvals"
- "finalize"
