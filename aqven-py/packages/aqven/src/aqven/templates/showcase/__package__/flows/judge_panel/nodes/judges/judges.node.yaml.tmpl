apiVersion: "aqven/v1"
kind: "Node"
node: "parallel"
description: "Три судьи разных семейств независимо оценивают черновики"
body:
  deepseek: "deepseek"
  qwen: "qwen"
  llama: "llama"
join:
  run: "agreeing_verdicts"
  with:
    min_agree: 2
out:
- name: "verdicts"
  type: "JudgeVerdict[]"
  description: "Вердикты судей, завершившиеся успешно"
  maxItems: 3
  from: "$ok"
