apiVersion: "aqven/v1"
kind: "Inference"
description: "Решение гарантийного случая по дефекту в рамках политик магазина со ссылкой на применённую политику"
in:
- name: "customer"
  type: "Customer"
  description: "Покупатель, которому принадлежит заказ"
- name: "order_id"
  type: "OrderId"
  description: "Номер заказа с дефектным товаром"
- name: "symptom"
  type: "DefectSymptom"
  description: "Симптом дефекта из анкеты обращения"
- name: "purchased_on"
  type: "Date?"
  description: "Дата покупки из анкеты; null, если покупатель её не указал"
- name: "safety_risk"
  type: "Bool"
  description: "Есть ли у дефекта признаки угрозы безопасности"
- name: "intake_extra"
  type: "Dynamic"
  description: "Поля приёма площадки, заполненные при разборе обращения"
- name: "policies"
  type: "Policy[]"
  description: "Политики магазина, найденные в базе знаний для категории товара"
  maxItems: 20
out:
- name: "resolution"
  type: "Resolution"
  description: "Принятое решение со ссылкой на политику"
allowed_sets:
- type: "PolicyId"
  from: "$in.policies[*].policy_id"
  labels_from: "$in.policies[*].title"
