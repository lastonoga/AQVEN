apiVersion: "aqven/v1"
kind: "Node"
node: "code"
description: "Закрывает обращение: номер, статус по согласованию, итоговый ответ, выбранные медиа и время закрытия"
run: "finalize"
in:
- name: "intent"
  type: "CaseIntent"
  description: "Итоговое намерение обращения"
  from: "$intent.out.intent"
- name: "tier"
  type: "CascadeTier"
  description: "Ступень каскада, давшая намерение"
  from: "$intent.out.tier"
- name: "record"
  type: "CaseRecord"
  description: "Анкета обращения"
  from: "$to_record.out"
- name: "resolution"
  type: "Resolution"
  description: "Решение по обращению"
  from: "$route.out.resolution"
- name: "reply"
  type: "ReplyDraft"
  description: "Ответ после полировки"
  from: "$polish.out.reply"
- name: "lead"
  type: "ReplyApproval"
  description: "Решение руководителя поддержки по ответу"
  from: "$approvals.out.lead"
- name: "media"
  type: "MediaApproval"
  description: "Решение бренд-редактора по медиа"
  from: "$approvals.out.media"
- name: "image"
  type: "Image"
  description: "Картинка-инструкция"
  from: "$illustrate.out.image"
- name: "voice"
  type: "Audio"
  description: "Голосовая версия ответа"
  from: "$voice.out.voice"
- name: "clip"
  type: "Video"
  description: "Короткий ролик по картинке"
  from: "$clip.out.clip"
out:
- name: "case_ref"
  type: "Text"
  description: "Номер обращения"
  maxLength: 31
  pattern: "^CASE-[0-9A-HJKMNP-TV-Z]{26}$"
- name: "status"
  type: "CaseStatus"
  description: "Отправлен ли ответ покупателю"
- name: "intent"
  type: "CaseIntent"
  description: "Итоговое намерение обращения"
- name: "tier"
  type: "CascadeTier"
  description: "Ступень каскада, давшая намерение"
- name: "record"
  type: "CaseRecord"
  description: "Анкета обращения"
- name: "resolution"
  type: "Resolution"
  description: "Решение по обращению"
- name: "reply"
  type: "ReplyDraft?"
  description: "Отправленный ответ; null, если ответ отклонён"
- name: "media"
  type: "ReplyMedia"
  description: "Медиа, одобренные к отправке с ответом"
- name: "closed_at"
  type: "DateTime"
  description: "Время закрытия обращения"
