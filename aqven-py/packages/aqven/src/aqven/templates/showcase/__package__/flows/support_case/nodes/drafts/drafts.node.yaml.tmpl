apiVersion: "aqven/v1"
kind: "Node"
node: "parallel"
description: "Три черновика ответа моделями трёх семейств"
body:
  gpt: "gpt"
  mistral: "mistral"
  gemini: "gemini"
join:
  use: "quorum"
  with:
    min_ok: 2
    on_error: "skip"
out:
- name: "candidates"
  type: "ReplyDraft[]"
  description: "Черновики ответа, завершившиеся успешно"
  maxItems: 3
  from: "$ok[*].reply"
