apiVersion: "aqven/v1"
kind: "Type"
type: "record"
description: "Покупатель Lumen с контактными данными"
pii: "pii"
fields:
- name: "customer_id"
  type: "CustomerId"
  description: "Идентификатор покупателя в CRM"
- name: "display_name"
  type: "Text"
  description: "Имя, которым покупатель представился"
  maxLength: 120
- name: "email"
  type: "Text?"
  description: "Электронная почта; null, если покупатель её не оставил"
  maxLength: 254
- name: "tier"
  type: "CustomerTier"
  description: "Уровень обслуживания"
- name: "locale"
  type: "Locale"
  description: "Язык и регион общения с покупателем"
