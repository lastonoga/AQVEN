import asyncio
import json
from collections.abc import AsyncIterator, Iterator
from dataclasses import dataclass
from pathlib import Path
from typing import Final

import pytest
from aqven.engine import configure_local_engines, shutdown_local_engines
from aqven.engine.assembly import standard_engine_setup
from aqven.ir import AgentModel, CompiledProject
from aqven.ports.models import ModelFactory
from aqven.runtime import ModelRoute, Project
from pydantic import SecretStr
from pydantic_ai import models
from pydantic_ai.messages import ModelMessage
from pydantic_ai.models import Model
from pydantic_ai.models.function import AgentInfo, DeltaToolCall, FunctionModel
from pydantic_ai.settings import ModelSettings

from __package__.types import Answer, Question

FLOW: Final = "answer_question"
REPLY: Final = "aqven runs typed AI workflows described in YAML."
OFFLINE_KEYS: Final = {"OPENROUTER_API_KEY": "offline"}

type Chunk = str | dict[int, DeltaToolCall]


async def scripted_reply(messages: list[ModelMessage], info: AgentInfo) -> AsyncIterator[Chunk]:
    arguments = json.dumps({"reply": REPLY})
    if not info.output_tools:
        yield arguments
        return
    yield {0: DeltaToolCall(name=info.output_tools[0].name, json_args=arguments, tool_call_id="reply")}


@dataclass(frozen=True, slots=True)
class FixedModels:
    model: Model

    def factory(self, project: CompiledProject, route: ModelRoute | None, choice: AgentModel) -> ModelFactory:
        return self

    def build(self, model: str, *, settings: ModelSettings | None, api_key: SecretStr) -> Model:
        return self.model


@pytest.fixture
def offline_engine(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
    monkeypatch.setattr(models, "ALLOW_MODEL_REQUESTS", False)
    scripted = FunctionModel(stream_function=scripted_reply, model_name="scripted")
    setup = standard_engine_setup(environ=OFFLINE_KEYS, state_dir=tmp_path / "state", factories=FixedModels(scripted))
    configure_local_engines(setup)
    yield
    shutdown_local_engines()


def test_answer_question_runs_offline(aqven_project: Project, offline_engine: None) -> None:
    flow = aqven_project.flow_typed(FLOW, Question, Answer)

    result = asyncio.run(flow.run(Question(text="  What   is aqven? ", tone="friendly")))

    assert result.status == "completed", result.error
    assert result.output == Answer(reply=REPLY, tone="friendly")
